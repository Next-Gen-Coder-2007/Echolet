# Server Port (Local standalone only; Vercel handles port automatically)
PORT=3000

# PostgreSQL Database URL (Required for persistent storage on Vercel, e.g., Supabase / Neon / Railway)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase Storage Configuration (Keep secret service role key ONLY on backend!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=echolet-media

# JWT Authentication
JWT_SECRET=your_super_long_secret_key_here
JWT_EXPIRES_IN=7d

# Node Environment ('production' on Vercel)
NODE_ENV=production

# Allowed Frontend Origins (Comma-separated URLs; *.vercel.app is automatically allowed)
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
